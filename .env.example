# Dunwell connector credentials. Never commit real values.
# Only needed for live (non-fixture) runs; `--fixtures` needs nothing here.

# Stripe — Dashboard > Developers > API keys
STRIPE_API_KEY=

# QuickBooks Online — OAuth2 access token + company realm id
QBO_ACCESS_TOKEN=
QBO_REALM_ID=
# Set to 1 to talk to the QuickBooks sandbox instead of production
QBO_SANDBOX=

# Xero — OAuth2 access token + the tenant you granted access to
XERO_ACCESS_TOKEN=
XERO_TENANT_ID=

# --------------------------------------------------------------------------- #
# Service (python -m dunwell.serve)
# --------------------------------------------------------------------------- #
# SQLite file for accounts, ledgers, and nudge history (default: dunwell.db)
DUNWELL_DB=

# Bind address and port. PaaS platforms set PORT and expect 0.0.0.0, not
# 127.0.0.1, or they return 502. The --host/--port flags still win.
HOST=127.0.0.1
PORT=8906

# Directory holding index.html/styles.css for the landing page.
# Auto-detects the sibling dunwell-landing checkout; set this to override.
DUNWELL_STATIC_DIR=

# Origins allowed to post the waitlist form from a browser. Needed only when
# the landing page is hosted somewhere other than this service (GitHub Pages,
# Netlify, a custom domain). Comma-separated, exact origins, no trailing
# slash. Empty means no cross-origin access at all.
#   DUNWELL_CORS_ORIGINS=https://maherimtiyaz.github.io,https://dunwell.app
DUNWELL_CORS_ORIGINS=

# Whether POST /api/signup creates accounts: "closed" (default) or "open".
# Leave it closed on any host reachable from the internet — the route needs no
# session, and an account can send mail from your SMTP credentials. With it
# closed, create accounts yourself: python -m dunwell.admin --email ...
DUNWELL_SIGNUP_MODE=closed

# Reverse proxies in front of the app, used to read the real client address
# from X-Forwarded-For for the rate limiters. "1" for a single proxy such as
# PythonAnywhere or a PaaS router; "0" ignores the header entirely.
DUNWELL_TRUSTED_PROXY_HOPS=1

# Company profile baked into every draft body, for accounts that set none.
# These are customer-visible, so change them before going live.
DUNWELL_COMPANY_NAME=Northwind Studio
DUNWELL_REPLY_TO=billing@northwind.example
# DUNWELL_SIGNATURE defaults to "<DUNWELL_COMPANY_NAME> - Billing"
DUNWELL_SIGNATURE=
DUNWELL_PAYMENT_LINK=https://pay.northwind.example/inv

# Email delivery. "dryrun" (default) records drafts without sending, so the
# whole flow works with no credentials. "api" delivers over HTTPS (works on
# hosts that block SMTP) and "smtp" uses port 587. Either live mode falls back
# to dryrun if its key/host is missing, rather than silently dropping mail.
DUNWELL_MAIL_MODE=dryrun

# API mode. The default endpoint is Resend; sign up, verify a sending domain,
# and paste the key. This is the recommended mode on Vercel-era PaaS free tiers.
DUNWELL_MAIL_API_KEY=
DUNWELL_MAIL_API_URL=https://api.resend.com/emails

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# "1" (default) upgrades the connection with STARTTLS; set "0" for none.
SMTP_TLS=1
# Envelope sender. Point this at a domain you control and have verified with
# your provider, or deliverability will suffer.
MAIL_FROM=billing@dunwell.app

# --------------------------------------------------------------------------- #
# Waitlist thank-you email
# --------------------------------------------------------------------------- #
# Sent once per address after it is stored. Set to 0 to collect addresses
# without mailing them.
DUNWELL_WAITLIST_WELCOME=1

# Public landing URL used for the email's CTA. No trailing slash.
#   DUNWELL_SITE_URL=https://dunwell.vercel.app
DUNWELL_SITE_URL=

# Signed at the bottom of the email, and used as the From display name.
DUNWELL_FOUNDER_NAME=Mahek
DUNWELL_BRAND_NAME=Dunwell

# Replies go here. Defaults to MAIL_FROM. Use a mailbox you actually read.
DUNWELL_WAITLIST_REPLY_TO=

# Optional postal address in the footer (required by CAN-SPAM for US
# recipients). Leave blank if you do not have one yet.
DUNWELL_MAILING_ADDRESS=
