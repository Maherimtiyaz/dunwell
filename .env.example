# Dunwell connector credentials. Never commit real values.
# Only needed for live (non-fixture) runs; `--fixtures` needs nothing here.

# Stripe — Dashboard > Developers > API keys
STRIPE_API_KEY=

# QuickBooks Online — OAuth2 access token + company realm id
QBO_ACCESS_TOKEN=
QBO_REALM_ID=
# Set to 1 to talk to the QuickBooks sandbox instead of production
QBO_SANDBOX=

# Xero — OAuth2 access token + the tenant you granted access to
XERO_ACCESS_TOKEN=
XERO_TENANT_ID=

# --------------------------------------------------------------------------- #
# Service (python -m dunwell.serve)
# --------------------------------------------------------------------------- #
# SQLite file for accounts, ledgers, and nudge history (default: dunwell.db)
DUNWELL_DB=

# Bind address and port. PaaS platforms set PORT and expect 0.0.0.0, not
# 127.0.0.1, or they return 502. The --host/--port flags still win.
HOST=127.0.0.1
PORT=8906

# Directory holding index.html/styles.css for the landing page.
# Auto-detects the sibling dunwell-landing checkout; set this to override.
DUNWELL_STATIC_DIR=

# Origins allowed to post the waitlist form from a browser. Needed only when
# the landing page is hosted somewhere other than this service (GitHub Pages,
# Netlify, a custom domain). Comma-separated, exact origins, no trailing
# slash. Empty means no cross-origin access at all.
#   DUNWELL_CORS_ORIGINS=https://maherimtiyaz.github.io,https://dunwell.app
DUNWELL_CORS_ORIGINS=

# Company profile baked into every draft body, for accounts that set none.
# These are customer-visible, so change them before going live.
DUNWELL_COMPANY_NAME=Northwind Studio
DUNWELL_REPLY_TO=billing@northwind.example
# DUNWELL_SIGNATURE defaults to "<DUNWELL_COMPANY_NAME> - Billing"
DUNWELL_SIGNATURE=
DUNWELL_PAYMENT_LINK=https://pay.northwind.example/inv

# Email delivery. "dryrun" (default) records drafts without sending, so the
# whole flow works with no credentials. Set "smtp" AND fill in SMTP_HOST to
# deliver for real — without SMTP_HOST it falls back to dryrun rather than
# silently dropping mail.
DUNWELL_MAIL_MODE=dryrun
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# "1" (default) upgrades the connection with STARTTLS; set "0" for none.
SMTP_TLS=1
# Envelope sender. Point this at a domain you control and have verified with
# your provider, or deliverability will suffer.
MAIL_FROM=billing@dunwell.app
